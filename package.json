{
  "name": "shaype-local-api",
  "version": "0.1.0",
  "description": "Cleanroom local re-implementation of the Shaype B2B Operations API for e2e testing on a dev machine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "shaype-local": "./dist/cli.js"
  },
  "files": [
    "dist",
    "spec",
    "README.md"
  ],
  "scripts": {
    "gen": "tsx scripts/gen-contract.ts",
    "predev": "npm run gen",
    "dev": "tsx src/cli.ts",
    "prebuild": "npm run gen",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run gen && tsc --noEmit -p tsconfig.json",
    "progress": "tsx scripts/progress.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
